# Backend / worker
DATABASE_URL=postgresql+psycopg://tracker_user:tracker_password@localhost:5433/google_skills_tracker
CORS_ALLOW_ORIGINS=http://localhost:3000

# Workbook paths (required for scheduler/scraping and optional for local overrides)
# COURSE_WORKBOOK_PATH: path to the course/lab workbook (must not contain participant PII).
# PARTICIPANT_WORKBOOK_PATH: path to participant workbook for seed/import flows (may contain PII; do not commit).
COURSE_WORKBOOK_PATH=./data/course.xlsx
PARTICIPANT_WORKBOOK_PATH=./data/clean_participants.xlsx

# Scheduler (worker)
SCRAPE_INTERVAL_MINUTES=60
SCRAPE_CONCURRENCY=3
SCRAPE_RUN_INITIAL=false
SCRAPE_LAUNCH_TIMEOUT_MS=30000
SCRAPE_NAVIGATION_TIMEOUT_MS=60000
SCRAPE_OPERATION_TIMEOUT_MS=120000
SCRAPE_SHUTDOWN_GRACE_SECONDS=180
LOG_LEVEL=INFO

# Database pool tuning (tune for API + worker concurrency and managed Postgres limits)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Frontend (Next.js) - NEXT_PUBLIC_* must be set at build time
NEXT_PUBLIC_API_URL=http://localhost:8000
